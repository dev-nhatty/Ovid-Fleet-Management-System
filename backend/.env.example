# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=fuel_trip_db

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Different value per environment. Never commit the real one.
SESSION_SECRET=replace_this_with_a_long_random_string

# Where the React app is served from (Vite's default dev port)
FRONTEND_URL=http://localhost:5173

PORT=4000
NODE_ENV=development
